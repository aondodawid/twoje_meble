{
  "name": "twoje-meble",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "serve:audit": "node scripts/run-serve.js",
    "serve:prod": "npm run build && node scripts/serve-dist.js",
    "build": "vue-cli-service build",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "test:browsers": "playwright test tests/browsers",
    "test:cache": "playwright test tests/e2e/product-cache.spec.ts --project=chromium",
    "test:lighthouse": "npm run build && lhci autorun --config=./tests/performance/lighthouse.config.js",
    "test:quality": "npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:browsers && npm run test:lighthouse"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.52.0",
    "@vue/cli-service": "^5.0.8",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^29.2.6",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^12.6.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vue-template-compiler": "^2.7.16",
    "workbox-webpack-plugin": "^7.3.0"
  }
}
